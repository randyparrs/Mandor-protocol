{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["agent/**/*.ts", "shared/**/*.ts", "scripts/**/*.ts", "executor/**/*.ts", "server/**/*.ts", "test/**/*.ts"],
  "exclude": [
    "scripts/showDeployerAddress.ts",
    "scripts/deployVaultV3.ts",
    "scripts/grantGovernanceRoleToSafe.ts",
    "scripts/deployVaultV4.ts",
    "scripts/deployVaultV5.ts",
    "scripts/deployLendingPositionRegistryV4.ts",
    "test/CapitalLimitRegistry.ts",
    "test/MandateVault.ts",
    "test/VaultFactory.ts",
    "test/VaultPolicy.ts",
    "test/getVaultState.ts"
  ]
}
